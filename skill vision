<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SKILLVISION - Contact Us</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --gold:#C5A36A;
  --gold-dark:#8B6F3A;
  --gold-light:#E8D5B5;
  --gold-btn: linear-gradient(180deg, #E9C78A 0%, #C5A36A 100%);
  --border: #C5A36A;
  --text:#6B5A2F;
  --bg:#FFFEFB;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--text)}

/* HEADER */
.top-header{
  display:flex;justify-content:space-between;align-items:center;
  padding:18px 40px;border-bottom:1px solid #EDE3CD;
  background:#FFFEFB;
}
.logo-wrap{display:flex;align-items:center;gap:12px}
.logo-circle{
  width:58px;height:58px;border:2px solid var(--gold);border-radius:50%;
  display:grid;place-items:center;font-size:28px;color:var(--gold)
}
.logo-text h1{font-family:'Cinzel',serif;font-size:26px;letter-spacing:2px;color:var(--gold-dark);line-height:1}
.logo-text p{font-size:13px;color:var(--gold-dark);font-family:'Cinzel',serif}
.top-dots{font-size:26px;letter-spacing:6px;color:var(--gold);cursor:pointer}
.close-x{font-size:32px;color:var(--gold);margin-left:30px;cursor:pointer}

/* NAV */
.nav-bar{
  display:flex;justify-content:space-between;align-items:center;
  padding:14px 40px;background:#FFFEFB;border-bottom:1px solid #F0E6D0;
}
.nav-links{display:flex;gap:18px;list-style:none}
.nav-links a{
  text-decoration:none;font-size:13px;font-weight:700;letter-spacing:0.5px;
  color:var(--gold-dark);padding-bottom:3px;border-bottom:2px solid transparent;
}
.nav-links a.active{border-color:var(--gold)}
.nav-brand{font-family:'Cinzel',serif;color:var(--gold-dark);text-align:right}
.nav-brand b{display:block;font-size:14px;letter-spacing:1px}
.nav-brand i{font-family:'Inter',serif;font-style:italic;font-size:13px}

/* MAIN */
.main{display:flex;min-height:85vh}
.left{
  width:38%;padding:30px 32px;background:#FFFEFB;
  border:1.5px solid var(--gold);margin:18px;position:relative;
}
.left::before,.left::after,.left .b1,.left .b2{
  content:'';position:absolute;width:28px;height:28px;
  background:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 30 30%22><path d=%22M2 2 Q15 2 15 15 Q2 15 2 2 M20 2 L28 2 L28 10%22 fill=%22none%22 stroke=%22%23C5A36A%22 stroke-width=%221%22/></svg>');
}
.left::before{top:4px;left:4px}
.left::after{top:4px;right:4px;transform:rotate(90deg)}
.left .b1{bottom:4px;left:4px;transform:rotate(-90deg);position:absolute}
.left .b2{bottom:4px;right:4px;transform:rotate(180deg);position:absolute}

.ornament{text-align:center;color:var(--gold);font-size:28px;margin-bottom:8px}
.title{
  font-family:'Cinzel',serif;font-size:46px;text-align:center;
  color:var(--gold-dark);letter-spacing:2px;margin-bottom:14px;
}
.desc{text-align:center;font-size:12.5px;line-height:1.6;margin-bottom:26px;color:var(--text)}

.form-row{display:flex;gap:14px;margin-bottom:14px}
.form-group{flex:1}
.form-group label{font-size:13px;font-weight:600;display:block;margin-bottom:6px;color:var(--gold-dark)}
.form-group input,.form-group textarea{
  width:100%;padding:10px 12px;border:1.2px solid var(--gold);
  border-radius:6px;background:#FFFEFB;font-size:13px;outline:none;color:var(--text)
}
.form-group textarea{height:70px;resize:none}
.check-row{display:flex;gap:8px;font-size:11.5px;margin:14px 0;line-height:1.4}
.check-row input{accent-color:var(--gold)}

.btn-submit{
  display:block;margin:12px auto;padding:10px 44px;
  background:var(--gold-btn);border:none;border-radius:8px;
  color:#fff;font-weight:700;letter-spacing:1px;cursor:pointer;
  box-shadow:0 4px 12px rgba(197,163,106,0.4);
}
.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:18px}
.action-btn{
  display:flex;align-items:center;gap:8px;justify-content:center;
  padding:14px 10px;background:var(--gold-btn);border:none;border-radius:8px;
  font-weight:700;font-size:12.5px;color:var(--gold-dark);cursor:pointer;
  box-shadow:0 4px 10px rgba(197,163,106,0.35);text-decoration:none;
}
.action-btn span{font-size:18px}

/* RIGHT MAP */
.right{
  width:62%;background:#E8DDD1;position:relative;overflow:hidden;
  display:flex;align-items:center;justify-content:center;
}
.map-img{
  width:100%;height:100%;object-fit:cover;opacity:0.9;
  background: linear-gradient(90deg, #E9E1D6 0%, #F5F0E8 100%);
}
.map-overlay{position:absolute;inset:0}
.badge-top{
  position:absolute;top:28px;right:32px;background:var(--gold);
  color:#fff;padding:7px 18px;border-radius:20px;font-size:13px;font-weight:700;
}
.pin-wrap{position:absolute;top:50%;left:50%;transform:translate(-40%,-50%);text-align:center}
.pin{
  width:44px;height:54px;background:var(--gold-btn);border-radius:50% 50% 50% 50% / 60% 60% 40% 40%;
  display:grid;place-items:center;box-shadow:0 6px 14px rgba(0,0,0,0.25);margin:0 auto 8px;
  position:relative;
}
.pin::after{
  content:'';width:18px;height:18px;background:#fff;border-radius:50%;
  border:2px solid var(--gold-dark)
}
.pin-wrap h3{font-size:15px;color:var(--gold-dark);font-weight:800}
.pin-wrap p{font-size:11px;color:var(--gold-dark)}
.badge-bottom{
  position:absolute;bottom:28px;right:28px;background:var(--gold);
  color:#fff;padding:8px 18px;border-radius:8px;font-size:13px;font-weight:600;
  cursor:pointer;text-decoration:none;
}

@media(max-width:900px){
  .main{flex-direction:column}
  .left,.right{width:100%;margin:0}
  .right{height:420px}
}
</style>
</head>
<body>

<div class="top-header">
  <div class="logo-wrap">
    <div class="logo-circle">✧</div>
    <div class="logo-text">
      <h1>SKILLVISION</h1>
      <p>Intelligent Job Market Analytics</p>
    </div>
  </div>
  <div style="display:flex;align-items:center">
    <div class="top-dots">•••</div>
    <div class="close-x">✕</div>
  </div>
</div>

<div class="nav-bar">
  <ul class="nav-links">
    <li><a href="#">HOME</a></li>
    <li><a href="#">ABOUT US</a></li>
    <li><a href="#">SERVICES</a></li>
    <li><a href="#">INSIGHTS</a></li>
    <li><a href="#">WORK WITH US</a></li>
    <li><a href="#">PRICING</a></li>
    <li><a class="active" href="#">CONTACT</a></li>
  </ul>
  <div class="nav-brand">
    <b>SKILLVISION</b>
    <i>Intelligent Job Market Analytics 🔒</i>
  </div>
</div>

<div class="main">
  <!-- LEFT FORM -->
  <div class="left">
    <div class="b1"></div><div class="b2"></div>
    <div class="ornament">❧</div>
    <h2 class="title">CONTACT US</h2>
    <p class="desc">We'd love to hear from you — reach out for market insights,<br>
      hiring solutions, data partnerships, or product support.<br>
      Fill out the form and our analytics team will<br>respond within 1 business day.</p>

    <div class="form-row">
      <div class="form-group"><label>First Name *</label><input type="text" placeholder="Jane"></div>
      <div class="form-group"><label>Last Name *</label><input type="text" placeholder="Doe"></div>
    </div>
    <div class="form-group" style="margin-bottom:14px"><label>Email *</label><input type="email" placeholder="jane.doe@example.com"></div>
    <div class="form-group"><label>Message *</label><textarea placeholder="Tell us how we can help with your workforce analytics needs..."></textarea></div>

    <div class="check-row">
      <input type="checkbox" checked>
      <span>Subscribe me to the SKILLVISION newsletter for market insights & updates.</span>
    </div>

    <button class="btn-submit">SUBMIT</button>

    <div class="action-grid">
      <a href="tel:+91XXXXXXXXXX" class="action-btn"><span>📞</span> CALL NOW</a>
      <a href="https://wa.me/91XXXXXXXXXX" class="action-btn"><span>💬</span> WHATSAPP</a>
      <a href="mailto:support@skillvision.in" class="action-btn"><span>✉️</span> EMAIL US</a>
      <a href="https://maps.google.com/?q=Naidupeta" target="_blank" class="action-btn"><span>📍</span> GET DIRECTIONS</a>
    </div>
  </div>

  <!-- RIGHT MAP -->
  <div class="right">
    <!-- Replace with real map iframe if needed -->
    <div class="map-img" style="background: #EDE6DA url('https://api.mapbox.com/styles/v1/mapbox/light-v10/static/-122.4,37.8,9,0/600x800?access_token=YOUR_TOKEN') center/cover;"></div>
    <div class="badge-top">SKILLVISION • HQ</div>
    <div class="pin-wrap">
      <div class="pin"></div>
      <h3>SKILLVISION HQ</h3>
      <p>San Francisco, CA • Job Market Analytics Hub</p>
    </div>
    <a href="https://maps.google.com" target="_blank" class="badge-bottom">Get Directions</a> 
  </div> 
</div> 
 
</body> 
</html> 
